{
  "name": "juicebag-mail",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "dev:service": "node scripts/run-with-env.mjs .env.service -- pnpm --filter @juicebag-mail/service-api dev",
    "dev:verify": "node scripts/run-with-env.mjs .env.service -- pnpm --filter @juicebag-mail/address-verify-api dev",
    "dev:agent": "node scripts/run-with-env.mjs .env.agent -- pnpm --filter @juicebag-mail/agent-api dev",
    "dev:ui": "node scripts/run-with-env.mjs .env.agent .env.service -- pnpm --filter @juicebag-mail/demo-ui dev",
    "dev:mcp": "node scripts/run-with-env.mjs .env.agent -- pnpm --filter @juicebag-mail/juicebag-mcp dev"
  },
  "devDependencies": {
    "@noble/curves": "2.2.0",
    "dotenv-cli": "^11.0.0"
  }
}
