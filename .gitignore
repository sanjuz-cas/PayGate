# ==============================================================================
# PayGate (Juicebag Mail) — Git Ignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Sensitive Credentials, Environment Variables & Keys
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.agent
.env.service
*.env
*.env.*

# Retain template / example configs
!.env.example
!.env.agent.example
!.env.service.example
!.env.*.example

# Algorand Wallets, Mnemonics & Cryptographic Keypairs
*.key
*.pem
*.seed
*.mnemonic
*.wallet
*.cert
*.crt
algorand/
keys/
secrets/

# MCP Server Configs & Private Agent Context
.mcp.json
mcp.json
*.mcp.json
!.mcp.json.example

# Prompts & AI Agent Scratch Context
prompts/
scratch/

# Markdown documentation, specifications & notes
*.md

# ------------------------------------------------------------------------------
# 2. SQLite Databases & Local Storage
# ------------------------------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
.data/
apps/*/.data/
storage/
apps/*/storage/

# ------------------------------------------------------------------------------
# 3. Dependencies & Package Manager Stores
# ------------------------------------------------------------------------------
node_modules/
.pnpm-store/
.npm/
.yarn/

# ------------------------------------------------------------------------------
# 4. Build Outputs, Compilations & Caches
# ------------------------------------------------------------------------------
dist/
build/
out/
.turbo/
.cache/
.parcel-cache/
*.tsbuildinfo
.eslintcache

# ------------------------------------------------------------------------------
# 5. Logs & Debugging
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 6. Python & Virtual Environments (if applicable)
# ------------------------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]

# ------------------------------------------------------------------------------
# 7. Operating System & IDE Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db

# IDEs & Editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.sw?
*.bak
*.tmp
*.temp